# TCOS environment configuration.
# Copy this file to .env and fill in the values. NEVER commit .env.
# Use URL-safe values (letters and digits) for passwords because they are
# placed inside DATABASE_URL.

# --- PostgreSQL (used by docker compose) ---------------------------------
POSTGRES_DB=tcos
POSTGRES_USER=tcos
# REQUIRED. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Django ---------------------------------------------------------------
# Only needed when running Django OUTSIDE Docker (make targets, local venv).
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://tcos:CHANGE_ME@localhost:5432/tcos

# Production only (config.settings.prod refuses to start without these).
# Generate the key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Comma-separated public host names, e.g. tcos.example.org
DJANGO_ALLOWED_HOSTS=
# Comma-separated origins, e.g. https://tcos.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# Redirect plain HTTP to HTTPS (production default: true).
DJANGO_SECURE_SSL_REDIRECT=true
# Set to true ONLY when a trusted reverse proxy terminates HTTPS and sets
# X-Forwarded-Proto. Never enable when Django is directly exposed.
DJANGO_BEHIND_TLS_PROXY=false
# HTTP Strict Transport Security (seconds, default one year).
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

# DEBUG, INFO, WARNING, ERROR
DJANGO_LOG_LEVEL=INFO

# --- Frontend dev server --------------------------------------------------
# Where the Vite dev server proxies /api. Docker compose overrides this.
BACKEND_URL=http://localhost:8000
